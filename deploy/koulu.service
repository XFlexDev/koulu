[Unit]
Description=koulu — Wilma client backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/koulu/server
EnvironmentFile=/etc/koulu.env
ExecStart=/opt/koulu/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8377
Restart=always
RestartSec=2
MemoryMax=256M
Nice=10

[Install]
WantedBy=multi-user.target
